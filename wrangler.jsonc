{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newpromax",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  // Aktifkan alamat newpromax.<akun>.workers.dev (bisa dipakai sebelum custom domain tersambung)
  "workers_dev": true,

  // Halaman statis (landing, app, admin) disajikan langsung oleh Cloudflare.
  // Path di bawah ini melewati Worker dulu (API, login, dan penjaga halaman).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/app", "/admin", "/dashboard"]
  },

  // Tanpa database_id: saat deploy, Wrangler memakai database bernama voicepromax-db di akun Anda,
  // atau membuatnya kalau belum ada. Tabel dibuat otomatis oleh Worker saat pertama kali dipakai.
  "d1_databases": [
    { "binding": "DB", "database_name": "voicepromax-db" }
  ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "voicepromax-audio" }
  ],

  // Pengiriman email verifikasi & reset password (Cloudflare Email Service).
  // SEMENTARA DINONAKTIFKAN supaya deploy bisa berhasil sebelum domain di-onboard.
  // Setelah voicepromax.com aktif di Email Service, hapus tanda // di 3 baris di bawah, lalu commit.
  // "send_email": [
  //   { "name": "EMAIL", "allowed_sender_addresses": ["noreply@voicepromax.com"] }
  // ],

  // Cek ulang pembayaran yang masih pending setiap 15 menit (cadangan kalau webhook gagal).
  "triggers": { "crons": ["*/15 * * * *"] },

  // Variabel yang diisi di dashboard (Settings -> Variables and Secrets) tidak dihapus saat deploy.
  // Isi ADMIN_EMAILS di sana: email Google Anda, tipe Text.
  "keep_vars": true,

  "vars": {
    "APP_URL": "https://voicepromax.com",
    // Sandbox untuk uji coba. Saat go-live ganti ke https://api.mayar.id/hl/v1
    "MAYAR_API_BASE": "https://api.mayar.io/hl/v1",
    "EMAIL_FROM": "noreply@voicepromax.com",
    "EMAIL_FROM_NAME": "Voice Promax"
  }

  // Secrets (isi di dashboard Settings -> Variables and Secrets, tipe Secret, atau `npx wrangler secret put NAMA`):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BOSON_API_KEY, MAYAR_API_KEY, MAYAR_WEBHOOK_TOKEN
}
